# Copy to terraform.tfvars and edit. Do NOT commit terraform.tfvars.

# DigitalOcean API token. Prefer `export DIGITALOCEAN_TOKEN=...` and omit this.
# do_token = "dop_v1_..."

# Public domain. Terraform adds it to DigitalOcean DNS — point the
# registrar's nameservers at ns{1,2,3}.digitalocean.com.
domain_name = "example.com"

# Optional tweaks.
# region     = "nyc3"
# node_size  = "s-2vcpu-2gb"
# node_count = 1
# db_size    = "db-s-1vcpu-1gb"
